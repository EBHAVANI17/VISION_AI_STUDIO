# Copy to .env and adjust. All settings are optional.

# Segmentation: ade (SegFormer-B2 · 150 classes) or voc (DeepLabV3-R50 · 21 classes)
VAS_SEGMENTER=ade

# Captioning: blip-base or blip-large
VAS_CAPTIONER=blip-base

# Translation: nllb (offline, ~2.4 GB on first use), google, or none
VAS_TRANSLATOR=nllb

# auto | cpu | cuda | mps
VAS_DEVICE=auto

# real | fake (deterministic fakes for tests and UI work)
VAS_MODELS=real

# Optional LoRA captioning adapter, e.g. EBHAVANI17/vision-ai-blip-coco-lora
# VAS_LORA_REPO=
# VAS_CAPTION_REVISION=
# VAS_SEGMENTER_REVISION=

# Input limits and rendering
VAS_MAX_EDGE=2048
VAS_MAX_UPLOAD_MB=15
VAS_OVERLAY_ALPHA=0.45
